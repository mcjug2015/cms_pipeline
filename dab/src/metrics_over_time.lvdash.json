{
  "datasets": [
    {
      "config": {
        "dimensions": [
          {
            "expr": "metric_name",
            "name": "metric_name"
          },
          {
            "expr": "last_updated",
            "name": "last_updated"
          },
          {
            "expr": "DATE_TRUNC('HOUR', last_updated)",
            "name": "date_trunc_hour"
          },
          {
            "expr": "DATE_TRUNC('DAY', last_updated)",
            "name": "date_trunc_day"
          }
        ],
        "measures": [
          {
            "expr": "SUM(CAST(payload:total_seconds AS DOUBLE))",
            "name": "total_seconds"
          },
          {
            "expr": "AVG(CAST(payload:total_seconds AS DOUBLE))",
            "name": "avg_total_seconds"
          },
          {
            "expr": "MAX(CAST(payload:total_seconds AS DOUBLE))",
            "name": "max_total_seconds"
          },
          {
            "expr": "MIN(CAST(payload:total_seconds AS DOUBLE))",
            "name": "min_total_seconds"
          },
          {
            "expr": "COUNT(*)",
            "name": "record_count"
          }
        ],
        "source": "${var.catalog}.${var.schema}.metrics",
        "version": "1.1"
      },
      "displayName": "Metrics Over Time",
      "name": "metrics_over_time"
    }
  ],
  "pages": [
